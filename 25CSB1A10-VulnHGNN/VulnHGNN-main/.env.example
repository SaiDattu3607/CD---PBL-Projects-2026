# VulnHGNN Environment Configuration
# Copy this file to .env and fill in your values

# --- Gemini / LLM Provider ---
VULNHGNN_LLM_API_KEY=your-gemini-api-key-here
VULNHGNN_LLM_MODEL=gemini-3.1-flash-lite
VULNHGNN_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VULNHGNN_FINDING_SIGNING_KEY=your-32-byte-random-hex-here

# --- API Access Control (optional) ---
# If set, all /api/* endpoints require X-API-Key: <value> header
# Leave blank to run in open mode (local development only)
VULNHGNN_API_KEY=

# --- Server ---
PORT=5000
